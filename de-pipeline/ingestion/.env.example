# Register at opensky-network.org/my-opensky (API Client)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

LOOKBACK_DAYS=3
OUTPUT_DIR=data

# "databricks" = write straight to opensky_raw.bronze; "" = write local files
INGEST_MODE=

# Needed for INGEST_MODE=databricks, load_to_databricks.py, ingest_adsbdb.py
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
# fallback instead of CLIENT_ID/SECRET
DATABRICKS_TOKEN=
