# Register at opensky-network.org/my-opensky (API Client)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

LOOKBACK_DAYS=1
OUTPUT_DIR=data

# Needed for load_to_databricks.py
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
# fallback instead of CLIENT_ID/SECRET
DATABRICKS_TOKEN=

ADMIN_PRINCIPAL=

# Needed for load_to_snowflake.py
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_DEV_SVC_USER=
# Either the full PEM private key text (including BEGIN/END lines), or a path to a .p8 key
# file - relative paths resolve against this .env file's own directory, e.g.:
# SNOWFLAKE_DEV_SVC_PRIVATE_KEY=.keys\snowflake_rsa_key.p8
SNOWFLAKE_DEV_SVC_PRIVATE_KEY=
# Only needed if the private key itself is passphrase-encrypted.
SNOWFLAKE_DEV_SVC_PRIVATE_KEY_PASSPHRASE=
# Optional - falls back to the user's default warehouse/role if unset. setup.sql creates
# OPENSKY_WH, so that's the natural value here once it exists.
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=
