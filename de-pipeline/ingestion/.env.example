# Copy to .env and fill in - register a client at https://opensky-network.org/my-opensky (API Client)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Optional overrides (defaults shown)
LOOKBACK_DAYS=3
OUTPUT_DIR=data

# "databricks" = ingest_opensky.py writes straight to opensky_raw.bronze, no local files.
# "" (default) = writes flights_raw.json/callsigns.csv/airports.csv to OUTPUT_DIR instead.
INGEST_MODE=

# Needed for INGEST_MODE=databricks, load_to_databricks.py, and ingest_adsbdb.py -
# see de-pipeline/README.md section 1 "Databricks landing setup"
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
# Fallback instead of the two above, if service-principal OAuth isn't available on your tenant
DATABRICKS_TOKEN=
